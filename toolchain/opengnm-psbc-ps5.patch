+            ctx->config->spi_ps_input_addr);
+        metadata_add_register(cx, cx_count, PSBC_MAX_CONTEXT_REGISTERS,
+            PSBC_CX_OFFSET(R_0286D8_SPI_PS_IN_CONTROL),
